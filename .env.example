# ------------------------------------------------------------------------------
# MERARESTO ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local and populate with your credentials.
# NEVER commit your actual .env or .env.local file to GitHub.
# ------------------------------------------------------------------------------

# Supabase Credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Root Domain & App Routing
NEXT_PUBLIC_ROOT_DOMAIN=meraresto.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_MENU_URL=http://localhost:3002
NEXT_PUBLIC_KITCHEN_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004

# Payments (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
